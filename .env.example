# Gemini API key: create one in Google AI Studio
GEMINI_API_KEY=
# Optional: configure these when their provider integrations are implemented
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
QWEN_API_KEY=

# fal.ai API key for image and video generation (https://fal.ai/dashboard/keys)
FAL_KEY=
# Optional: override default fal.ai models
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_VIDEO_MODEL=fal-ai/wan/v2.2-a14b/text-to-video
