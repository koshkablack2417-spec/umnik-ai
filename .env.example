# Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional chat providers. Each provider requires its own API account/key and may bill separately.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
QWEN_API_KEY=

# fal.ai API key for image and video generation (https://fal.ai/dashboard/keys)
FAL_KEY=
# Optional: override default fal.ai models
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_VIDEO_MODEL=fal-ai/wan/v2.2-a14b/text-to-video

# Supabase Auth + cloud chat history (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe subscriptions: create recurring EUR prices for 5€/week, 15€/month, 50€/year
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase service role key: server-only, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated account emails that receive unlimited image/video generation.
# Set this only for the verified developer account; keep private server-side.
UMNIK_OWNER_EMAILS=developer@example.com
